# Telegram Bot API Token (@BotFather)
TELEGRAM_TOKEN=123456789:AAExampleBotTokenString

# Secret token used to verify incoming Telegram Webhook requests (HMAC constant-time check)
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-token

# S3 Bucket name storing yikama_takip.csv
S3_BUCKET=your-s3-bucket-name

# Comma-separated list of authorized Telegram Chat IDs
ALLOWED_CHAT_IDS=123456789,-100987654321
